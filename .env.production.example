# Copy to .env.production on the server (never commit the real file).
DOMAIN=erp.example.uz
POSTGRES_PASSWORD=change-me-long-random
# 32+ random characters, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_TTL=12h
# From @BotFather. Empty = bot disabled (messages stay queued).
TELEGRAM_BOT_TOKEN=
BACKUP_KEEP_DAYS=14
