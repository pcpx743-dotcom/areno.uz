# --- API ---
# PostgreSQL (staging/prod):  postgres://user:pass@host:5432/sport_erp
# Local without Docker:       pglite://./.data/pg   (embedded Postgres, file-based)
DATABASE_URL=pglite://./.data/pg
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=12h
PORT=4000
CORS_ORIGIN=http://localhost:5173


# Get a token from @BotFather; leave empty to disable the parent bot (messages stay queued)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# Set to true behind nginx / ngrok so login rate limiting sees real client IPs
TRUST_PROXY=false
# Production single container: serve the built web app from the API
# WEB_DIST=/app/apps/web/dist
